# Public site URL used for canonical links, sitemap, robots, and JSON-LD.
# Optional on Vercel: falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Quote form email delivery (not wired up yet, see app/api/quote/route.ts)
RESEND_API_KEY=
QUOTE_TO_EMAIL=

# GoHighLevel API v2. Quote requests become contacts (tagged "website lead")
# with a note. Private Integration token with the contacts.write scope, and the
# sub-account's Location ID (Settings > Business Profile).
GHL_CONTACT_FORM_API_KEY=
GHL_LOCATION_ID=
